pagloss<-threats$`Agric%` /(threats$`Agric%`+threats$`House%`)
pagloss[is.na(pagloss)]<-0
## create list of losses separately for ag and housing
lost.list2a<-lapply(lost.list2, function(x) {
t(apply(x,1,function(y) y*pagloss))
})
##list housing
